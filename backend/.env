# Shared backend defaults (committed). Loaded first; non-secret tuning and model defaults.
# See .cursor/skills/use-environment/references/overview.md for hierarchy. Keys use PUBLIC_* / PRIVATE_* (see .env.local.example).

PUBLIC_JWT_ALGORITHM=HS256
PUBLIC_REFRESH_TOKEN_EXPIRATION_DAYS=7

PUBLIC_PG_POOL_MIN=2
PUBLIC_PG_POOL_MAX=10
PUBLIC_PG_ACQUIRE_TIMEOUT=10
PUBLIC_PG_COMMAND_TIMEOUT=30

# Supabase direct Postgres defaults (same in local stack and hosted).
PUBLIC_DB_USER=postgres
PUBLIC_DB_NAME=postgres

PUBLIC_EMBEDDING_MODEL=text-embedding-3-small
PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-6
PUBLIC_ANTHROPIC_FAST_MODEL=claude-sonnet-4-6

PUBLIC_SESSION_COST_CAP=2.00
PUBLIC_XERO_SYNC_HOUR=2

PUBLIC_LOG_LEVEL=INFO
PUBLIC_WORKERS=1
PUBLIC_REQUEST_TIMEOUT=30
PUBLIC_AI_REQUEST_TIMEOUT=120
PUBLIC_MAX_CONCURRENT_GENERATIONS=4
PUBLIC_GENERATION_QUEUE_TIMEOUT=10

PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
