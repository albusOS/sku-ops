# Development overrides (committed). Loaded after backend/.env when PUBLIC_ENV=development or test.
# Process env (e.g. pixi PRIVATE_DATABASE_URL) still wins if set before startup.
# Usually omit PUBLIC_ENV: default is development so this file is used. Override via shell/pixi/.env.local if needed.

# Direct Postgres (local Supabase). PUBLIC_DB_USER/PUBLIC_DB_NAME in backend/.env;
# hosted DB password: PRIVATE_DB_PASSWORD in .env.local.
# config builds PRIVATE_DATABASE_URL override or postgresql+asyncpg:// from parts.
PUBLIC_DB_PASSWORD=postgres
PUBLIC_DB_HOST=127.0.0.1
PUBLIC_DB_PORT=54322
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
PUBLIC_CORS_ORIGINS=*
PUBLIC_REDIS_URL=

# Longer access tokens for local dev unless set in .env.local
PUBLIC_JWT_ACCESS_EXPIRATION_MINUTES=480
