# Development overrides (committed). Loaded after backend/.env when ENV=development or ENV=test.
# Process env (e.g. pixi DATABASE_URL) still wins if set before startup (override=False on initial load).

ENV=development

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
CORS_ORIGINS=*
REDIS_URL=

# Longer access tokens for local dev unless JWT_ACCESS_EXPIRATION_MINUTES is set in .env.local
JWT_ACCESS_EXPIRATION_MINUTES=480
