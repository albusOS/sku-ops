# Development overrides (committed). Loaded after backend/.env when ENV=development or ENV=test.
# Process env (e.g. pixi DATABASE_URL or DB_HOST) still wins if set before startup (override=False on initial load).

ENV=development

# Direct Postgres (local Supabase). DB_USER/DB_NAME in backend/.env; production DB_PASSWORD in .env.local.
# config.DATABASE_URL is built as postgresql+asyncpg://...
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=54322
SUPABASE_URL=http://127.0.0.1:54321
CORS_ORIGINS=*
REDIS_URL=

# Longer access tokens for local dev unless JWT_ACCESS_EXPIRATION_MINUTES is set in .env.local
JWT_ACCESS_EXPIRATION_MINUTES=480
