# Reference for backend environment variables (documentation only).
#
# Layered files (see docs/environment.md):
#   backend/.env                  — shared committed defaults (PUBLIC_*)
#   backend/.env.development      — local dev overrides (PUBLIC_*)
#   backend/.env.production       — production non-secret hints (PUBLIC_*)
#   backend/.env.local            — secrets (PRIVATE_*); copy from .env.local.example
#
# Legacy: PUBLIC_ENV absent before import falls back to ENV for profile selection only.
# Docker Compose may use repo-root .env (see .env.production.example).

# ── Environment ────────────────────────────────────────────────────────────────
# PUBLIC_ENV=development|test|production

# ── Database ───────────────────────────────────────────────────────────────────
# Built as postgresql+asyncpg:// from PUBLIC_DB_* or override:
# PRIVATE_DATABASE_URL=postgresql://user:pass@host:5432/db
# PUBLIC_DB_USER=postgres
# PUBLIC_DB_PASSWORD=postgres          (local default; prod secret: PRIVATE_DB_PASSWORD in .env.local)
# PUBLIC_DB_HOST=127.0.0.1
# PUBLIC_DB_PORT=54322
# PUBLIC_DB_NAME=postgres
# PUBLIC_DB_SSL_MODE=require
# PUBLIC_PG_POOL_MIN=2
# PUBLIC_PG_POOL_MAX=10
# PUBLIC_PG_COMMAND_TIMEOUT=30
# PUBLIC_PG_ACQUIRE_TIMEOUT=10

# ── Supabase ───────────────────────────────────────────────────────────────────
# PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PRIVATE_SUPABASE_SECRET_KEY=sb_secret_...

# ── Redis ──────────────────────────────────────────────────────────────────────
# PUBLIC_REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# PRIVATE_JWT_SECRET=your-supabase-jwt-secret
# PUBLIC_JWT_ALGORITHM=HS256
# PUBLIC_JWT_ACCESS_EXPIRATION_MINUTES=15
# PUBLIC_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# PUBLIC_CORS_ORIGINS=https://your-domain.com
# PUBLIC_CORS_ORIGIN_REGEX=https://frontend-.*\.vercel\.app

# ── AI / LLM ───────────────────────────────────────────────────────────────────
# PRIVATE_ANTHROPIC_API_KEY=
# PRIVATE_OPENROUTER_API_KEY=
# PRIVATE_OPENAI_API_KEY=
# PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-6
# PUBLIC_ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# PUBLIC_AGENT_PRIMARY_MODEL=anthropic:claude-sonnet-4-6
# PUBLIC_MODEL_REGISTRY_INFRA_SYNTHESIS=anthropic:claude-haiku-4-5
# PUBLIC_MODEL_REGISTRY_INFRA_CLASSIFIER=anthropic:claude-haiku-4-5
# PUBLIC_EMBEDDING_MODEL=text-embedding-3-small
# PUBLIC_SESSION_COST_CAP=2.00
# PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Xero ───────────────────────────────────────────────────────────────────────
# PUBLIC_XERO_CLIENT_ID=
# PRIVATE_XERO_CLIENT_SECRET=
# PUBLIC_XERO_REDIRECT_URI=
# PUBLIC_XERO_SYNC_HOUR=2

# ── Server ─────────────────────────────────────────────────────────────────────
# PUBLIC_WORKERS=1
# PUBLIC_MAX_CONCURRENT_GENERATIONS=4
# PUBLIC_GENERATION_QUEUE_TIMEOUT=10
# PUBLIC_REQUEST_TIMEOUT=30
# PUBLIC_AI_REQUEST_TIMEOUT=120
# PUBLIC_LOG_LEVEL=INFO

# ── Observability ──────────────────────────────────────────────────────────────
# PRIVATE_SENTRY_DSN=https://...@sentry.io/...
# PRIVATE_METRICS_TOKEN=

# ── Other ──────────────────────────────────────────────────────────────────────
# PUBLIC_FRONTEND_URL=https://app.example.com
# PUBLIC_ALLOW_PUBLIC_AUTH=0        (1/true only for explicit local-auth debugging)
