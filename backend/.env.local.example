# Copy to backend/.env.local (gitignored). Overrides backend/.env and .env.* profiles.
#
# Naming:
#   PRIVATE_* — secrets (tokens, passwords, API keys). Set here or on the host platform.
#   PUBLIC_*  — non-secrets (URLs, feature flags). Often committed in .env / .env.development.
#
# Database password: production or hosted DB uses PRIVATE_DB_PASSWORD. Local Supabase default
# is PUBLIC_DB_PASSWORD=postgres in backend/.env.development (safe to commit).

# ==============================================================================
#                   IMPORTANT INFORMATION ABOUT THE SECRETS
# ==============================================================================
# These values are not committed. Use them in development and production hosts.

# For production, set secrets in backend_digital_ocean_deployment (or equivalent);
# they are injected into App Platform / .do/app.yaml.
# ==============================================================================

# ==============================================================================
# Database
# ==============================================================================
# PRIVATE_DB_PASSWORD=your-supabase-db-password

# ==============================================================================
# Supabase
# ==============================================================================
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PRIVATE_SUPABASE_SECRET_KEY=sb_secret_...

# ==============================================================================
# Authentication & JWT (must match Supabase project JWT secret in production)
# ==============================================================================
# PRIVATE_JWT_SECRET=

# ==============================================================================
# API Keys (AI)
# ==============================================================================
# PRIVATE_ANTHROPIC_API_KEY=
# PRIVATE_OPENAI_API_KEY=
# PRIVATE_OPENROUTER_API_KEY=

# ==============================================================================
# Xero
# ==============================================================================
# PUBLIC_XERO_CLIENT_ID=
# PRIVATE_XERO_CLIENT_SECRET=
# PUBLIC_XERO_REDIRECT_URI=

# ==============================================================================
# Observability
# ==============================================================================
# PRIVATE_SENTRY_DSN=
# PRIVATE_METRICS_TOKEN=

# ==============================================================================
# URLs / CORS (when not in committed profile files)
# ==============================================================================
# PUBLIC_FRONTEND_URL=
# PUBLIC_CORS_ORIGINS=https://app.example.com
# PUBLIC_CORS_ORIGIN_REGEX=

# Optional: full DB URI (Docker/CI/App Platform). Takes precedence over DB parts.
# PRIVATE_DATABASE_URL=postgresql://user:pass@host:5432/dbname
