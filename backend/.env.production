# Production non-secret defaults (committed). Loaded after backend/.env when PUBLIC_ENV=production.
# Secrets belong in backend/.env.local or the deployment platform.

PUBLIC_ENV=production

PUBLIC_JWT_ACCESS_EXPIRATION_MINUTES=15

# Direct Supabase Postgres (not transaction pooler). PUBLIC_DB_USER/PUBLIC_DB_NAME in backend/.env.
PUBLIC_DB_HOST=db.fjzacucejlieklmmhwsm.supabase.co
PUBLIC_DB_PORT=5432
PUBLIC_DB_SSL_MODE=require
PUBLIC_SUPABASE_URL=https://fjzacucejlieklmmhwsm.supabase.co

PUBLIC_WORKERS=2
PUBLIC_PG_POOL_MIN=2
PUBLIC_PG_POOL_MAX=20
