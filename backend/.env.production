# Production non-secret defaults (committed). Loaded after backend/.env when ENV=production.
# DB_PASSWORD (and other API secrets) belong in backend/.env.local or the deployment platform.

ENV=production

JWT_ACCESS_EXPIRATION_MINUTES=15

# Direct Supabase Postgres (not transaction pooler). DB_USER/DB_NAME in backend/.env.
DB_HOST=db.fjzacucejlieklmmhwsm.supabase.co
DB_PORT=5432
DB_SSL_MODE=require
SUPABASE_URL=https://fjzacucejlieklmmhwsm.supabase.co

WORKERS=2
PG_POOL_MIN=2
PG_POOL_MAX=20
