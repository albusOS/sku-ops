# Production non-secret defaults (committed). Loaded after backend/.env when PUBLIC_ENV=production.
# Secrets (PRIVATE_*) are injected by App Platform from GitHub Actions (.do/app.yaml template).
#
# Replace placeholder domains below with your real Vercel production URL before shipping.
# PUBLIC_CORS_ORIGINS must not be * or empty in production (config enforces this).

PUBLIC_ENV=production

PUBLIC_JWT_ACCESS_EXPIRATION_MINUTES=15

# Direct Supabase Postgres (not transaction pooler). PUBLIC_DB_USER/PUBLIC_DB_NAME in backend/.env.
PUBLIC_DB_HOST=db.fjzacucejlieklmmhwsm.supabase.co
PUBLIC_DB_PORT=5432
PUBLIC_DB_SSL_MODE=require
PUBLIC_SUPABASE_URL=https://fjzacucejlieklmmhwsm.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZP4_sc3ipWdS2_m8Fcys_g_uu3CR3aL

# Comma-separated stable Vercel origins (production + www if used).
PUBLIC_CORS_ORIGINS=https://REPLACE_WITH_VERCEL_PRODUCTION_URL
# Optional: Vercel preview deploys (regex). Example: https://sku-ops-.*\.vercel\.app
PUBLIC_CORS_ORIGIN_REGEX=
PUBLIC_FRONTEND_URL=https://REPLACE_WITH_VERCEL_PRODUCTION_URL

PUBLIC_XERO_CLIENT_ID=
PUBLIC_XERO_REDIRECT_URI=https://REPLACE_WITH_API_HOST/api/beta/finance/xero/callback

PUBLIC_WORKERS=2
PUBLIC_PG_POOL_MIN=2
PUBLIC_PG_POOL_MAX=20
