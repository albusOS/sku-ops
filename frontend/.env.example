# Frontend env reference (Vite exposes only VITE_* to the browser).
# See .cursor/skills/use-environment/references/overview.md for the file hierarchy.
#
# Typical layout:
#   frontend/.env                  — shared (committed)
#   frontend/.env.development      — local public URLs (committed)
#   frontend/.env.production       — production build hints (committed)
#   frontend/.env.local            — publishable key etc. (gitignored)
#
# Local development
# ─────────────────
# Leave VITE_BACKEND_URL unset — Vite proxies /api to localhost:8000 (vite.config.js).
# Set VITE_SUPABASE_* from: supabase status -o env
#
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Vercel production (build-time — changing vars requires redeploy)
# VITE_BACKEND_URL=https://api.your-domain.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Self-serve admin sign-up gate (Login page, sign-up mode). Override in `.env.local`.
# VITE_ADMIN_LOGIN_CODE=1234

# Optional
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
