# Frontend environment variables (Vite: only VITE_* are exposed to the browser).
#
# Local development
# ─────────────────
# Leave VITE_BACKEND_URL unset — Vite proxies /api to localhost:8000 (see vite.config.js).
# For Supabase, use values from: `supabase status -o env` (or `pixi run frontend`, which exports them).
#
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Vercel production (build-time)
# ───────────────────────────────
# Set these in Vercel > Project Settings > Environment Variables. All three are required.
# They are baked into the JS bundle — changing them requires a redeploy.
#
# Backend API URL — no trailing slash. Use your hosted API origin (e.g. DigitalOcean App Platform
# or custom domain).
# VITE_BACKEND_URL=https://api.your-domain.com
#
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# See docs/deploy.md for the full deployment playbook.

# Optional
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
