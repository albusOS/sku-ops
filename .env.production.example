# ──────────────────────────────────────────────────────────────────────────────
# Scope: repo-root — consumed by docker-compose.yml for optional local Docker stack.
# Copy to .env and fill in all REQUIRED values before `docker compose up`.
# Backend-local native dev uses backend/.env instead.
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
PUBLIC_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. Supabase direct Postgres URI, port 5432 (not pooler 6543).
PRIVATE_DATABASE_URL=

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# REQUIRED. Server refuses to start if unset or default.
#
# IMPORTANT: For Supabase Auth deployments, this MUST be your Supabase project's
# JWT secret — find it at Dashboard > Settings > API > JWT Secret.
# Do NOT generate a random value; the backend uses this to verify Supabase tokens.
PRIVATE_JWT_SECRET=

# Token lifetimes (optional — sensible defaults built in)
# PUBLIC_JWT_ACCESS_EXPIRATION_MINUTES=15
# PUBLIC_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# REQUIRED. Comma-separated allowed origins. Must NOT be "*" in production.
PUBLIC_CORS_ORIGINS=https://your-domain.com

# Optional regex for additional CORS origins (applied alongside PUBLIC_CORS_ORIGINS).
# Useful for Vercel preview deployments which get unique URLs.
# PUBLIC_CORS_ORIGIN_REGEX=https://frontend-.*\.vercel\.app

# ── Frontend URL ─────────────────────────────────────────────────────────────
# REQUIRED when frontend and backend are on separate origins (e.g. Vercel + hosted API).
# Used for OAuth callback redirects (e.g. Xero).
# PUBLIC_FRONTEND_URL=https://app.your-domain.com

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN (optional but recommended). Get one at https://sentry.io
# PRIVATE_SENTRY_DSN=https://...@sentry.io/...

# Log level (default: INFO)
# PUBLIC_LOG_LEVEL=INFO

# Bearer token to protect /metrics endpoint. Recommended in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PRIVATE_METRICS_TOKEN=

# ── Uvicorn workers ──────────────────────────────────────────────────────────
# Number of backend worker processes. Rule of thumb: 2 × CPU cores + 1.
PUBLIC_WORKERS=4

# ── Postgres connection pool (optional) ──────────────────────────────────────
# PUBLIC_PG_POOL_MIN=2
# PUBLIC_PG_POOL_MAX=10

# ── AI / LLM ────────────────────────────────────────────────────────────────
# Set at least one to enable AI features (assistant, UOM classification, OCR).
# Setting BOTH Anthropic + OpenRouter enables automatic fallback when Anthropic
# is overloaded — requests route through OpenRouter transparently.
# PRIVATE_ANTHROPIC_API_KEY=sk-ant-...
# PRIVATE_OPENROUTER_API_KEY=sk-or-...
# PRIVATE_OPENAI_API_KEY=sk-...

# Model overrides (optional — defaults are sensible)
# PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-6
# PUBLIC_ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# PUBLIC_AGENT_PRIMARY_MODEL=anthropic:claude-sonnet-4-6
# PUBLIC_SESSION_COST_CAP=2.00

# ── Xero OAuth 2.0 ──────────────────────────────────────────────────────────
# Register at developer.xero.com. Leave blank to disable Xero integration.
# PUBLIC_XERO_CLIENT_ID=
# PRIVATE_XERO_CLIENT_SECRET=
# PUBLIC_XERO_REDIRECT_URI=https://your-domain.com/api/xero/callback

# ── Supabase (API URL for JWKS; often same as VITE_SUPABASE_URL) ─────────────
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ── Rate Limits (optional — defaults built in) ──────────────────────────────
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_CHAT=30/minute
# RATE_LIMIT_API=120/minute

# ── Frontend / Supabase (baked into JS at build time) ─────────────────────────
# REQUIRED when building frontend for production. Set in Vercel (or local env) before `pnpm run build`.
# They cannot be changed after the build — a rebuild is needed.
# Find these at Supabase Dashboard > Settings > API keys (publishable key; format sb_publishable_...).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set when backend API is on a different origin than the frontend (typical for Vercel + API host).
# VITE_BACKEND_URL=https://api.your-domain.com
